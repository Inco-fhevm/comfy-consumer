NETWORK=testnet                 # testnet (Base Sepolia) | mainnet (Base)
PORT=8080

# Webhook providers, comma list; first is active. EMPTY = reconciler-only:
# no webhook, no per-delivery billing, catches every wrapper via RPC polling.
# Recommended until QuickNode. Set to "quicknode"/"alchemy" to enable a live webhook.
ENABLED_PROVIDERS=
QUICKNODE_SIGNING_KEY=          # required only if quicknode is enabled
ALCHEMY_SIGNING_KEY=            # required only if alchemy is enabled

PRIMARY_RPC_URL=https://sepolia.base.org   # reconciler + metadata reads run here
BACKUP_RPC_URL=https://sepolia.base.org    # failover; use a DIFFERENT provider in prod
DATABASE_URL=postgres://indexer:indexer@localhost:5432/indexer
CHECK_INTERVAL=15000            # reconciler poll interval (ms) — lower = fresher, more RPC
START_BLOCK=44354522            # factory deploy block; backfill from here (unset ⇒ from now)

# CORS: comma-list of allowed frontend origins. EMPTY = allow any origin (dev).
# e.g. CORS_ORIGINS=https://app.example.com,http://localhost:3000
CORS_ORIGINS=

# USD prices (served at GET /prices). Source: DeFiLlama — free, keyless, no
# credits. Only the background loop calls upstream (batched, 1 call/tick); the
# endpoint always serves the DB cache. Defaults ON for mainnet, OFF otherwise.
# PRICES_ENABLED=              # "true"/"false" to force; unset = on iff base mainnet
# PRICE_REFRESH_INTERVAL=60000 # refresh cadence (ms); floored at 15000
# PRICE_TTL_SECONDS=600        # age after which a cached price is flagged `stale`
