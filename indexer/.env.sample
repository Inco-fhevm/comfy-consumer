# Ponder reads .env.local (NOT .env) when running locally. On a host that
# injects real environment variables (Railway, Fly, Docker) the file is unused.
# Copy to .env.local for local dev.

NETWORK=testnet                 # testnet (Base Sepolia) | mainnet (Base)
PORT=8080

# Ponder treats these as ONE list: it load-balances across them and fails over
# automatically. Use two DIFFERENT providers so an outage on one is survivable.
PRIMARY_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>
BACKUP_RPC_URL=https://<your>.base-sepolia.quiknode.pro/<key>/

# Postgres. Unset ⇒ embedded PGlite under .ponder/ (local dev only).
# Railway: use the *internal* host in production (private network, no SSL, no
# egress cost). The public proxy needs sslmode=no-verify — its cert is self-signed.
DATABASE_URL=postgresql://user:pass@host:5432/db

# Ponder owns this schema and locks it: one live instance per schema.
# KEEP IT STABLE ACROSS DEPLOYS. Changing it forces a full re-index.
DATABASE_SCHEMA=comfy

# Consent + price cache live here. Ponder never touches this schema, so it
# survives re-indexing. Never drop `ponder_sync` either — that is the RPC cache
# that makes a restart free.
OFFCHAIN_SCHEMA=comfy_offchain

START_BLOCK=44988104            # factory deploy block; only read when the sync cache is cold
CHECK_INTERVAL=15000            # head polling interval (ms); latency only, no blocks are skipped

# Override the addresses from @comfy/config, so a redeploy is config not a release.
# WRAPPER_FACTORY=0x…
# COMMON_VAULT=0x…

# CORS: comma list of allowed origins. EMPTY = allow any (dev only).
CORS_ORIGINS=http://localhost:3000

# Per-IP fixed-window rate limit, in-process. Abuse damping, not a security
# control — put a WAF/CDN in front for that.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_ALLOWLIST=

# USD prices (GET /prices). Source: DeFiLlama — free, keyless. Only the
# background loop calls upstream; the endpoint always serves the DB cache.
# PRICES_ENABLED=true
# PRICE_REFRESH_INTERVAL=60000  # floored at 15000
# PRICE_TTL_SECONDS=600         # age after which a cached price is flagged `stale`
