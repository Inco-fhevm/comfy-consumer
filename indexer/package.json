{
  "name": "@comfy/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ponder dev --port ${PORT:-8080}",
    "start": "node scripts/start.mjs",
    "serve": "ponder serve --port ${PORT:-8080} --schema ${DATABASE_SCHEMA:-comfy}",
    "codegen": "ponder codegen",
    "db": "ponder db",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:prune": "ponder db prune"
  },
  "dependencies": {
    "@comfy/config": "workspace:*",
    "hono": "^4.10.7",
    "pg": "^8.12.0",
    "ponder": "0.17.4",
    "viem": "^2.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
